# Optionnel : ai-service lit d'abord ../.env (racine du dépôt), puis ce fichier.
# Fournisseur : stub (aucun appel réseau) ou gemini (LLM_API_KEY et LLM_MODEL obligatoires).
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Jetons de réflexion autorisés au modèle (bas = rapide et peu coûteux). 0 désactive si le modèle l'accepte.
LLM_THINKING_BUDGET=128
# Synthèse vocale Gemini : modèle de synthèse.
LLM_TTS_MODEL=gemini-3.8-flash-tts
# Voix (module Cours) : ordre de la chaîne de secours ; un fournisseur sans clé est ignoré.
TTS_FOURNISSEURS=elevenlabs,gemini,gtts,edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_PROF=
ELEVENLABS_VOICE_ETUDIANT=
ELEVENLABS_MODEL=eleven_multilingual_v2
