# Copier ce fichier en .env (jamais commité) puis adapter les valeurs.
# Lu par docker compose ET par les services Spring Boot (spring.config.import).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=bawsla
MYSQL_PASSWORD=bawsla
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- JWT (partagé user-service <-> api-gateway) ---
# Au moins 32 caractères (HS256). Générer : openssl rand -base64 48
JWT_SECRET=change-me-dev-secret-bawsla-au-moins-32-caracteres-svp
JWT_EXPIRATION_MS=86400000

# --- Compte ADMIN créé au démarrage de user-service s'il n'existe pas ---
ADMIN_EMAIL=admin@bawsla.tn
ADMIN_PASSWORD=Admin123!

# --- IA (ai-service uniquement, jamais dans le front) ---
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Jetons de réflexion autorisés au modèle Gemini (bas = rapide et peu coûteux). 0 désactive si le modèle l accepte.
LLM_THINKING_BUDGET=128
# Synthèse vocale Gemini : modèle de synthèse (le nom par défaut convient tant que ce modèle est disponible).
LLM_TTS_MODEL=gemini-3.8-flash-tts
# Vectorisation (RAG du forum et du cours). Valeurs par défaut, à décommenter seulement pour les changer.
# LLM_EMBEDDING_MODEL=gemini-embedding-001
# LLM_EMBEDDING_DIMENSION=768
# Taille max (caractères) d'un texte envoyé au LLM après masquage par le Sanitizer.
# SANITIZER_MAX_CHARS=20000

# --- Fournisseur LLM de SECOURS (ai-service) ---
# Vide = pas de secours. openai ou groq = on bascule dessus quand Gemini répond 429 (quota) ou est indisponible.
LLM_SECOURS=
OPENAI_API_KEY=
# Modèle économique (doc OpenAI) : gpt-6-luna, 0,10 $ / 0,50 $ par million de jetons.
OPENAI_MODEL=gpt-6-luna
# Effort de réflexion : none, low, medium, high… (bas = rapide et peu coûteux).
OPENAI_REASONING_EFFORT=low
# Synthèse vocale OpenAI (fournisseur « openai » de TTS_FOURNISSEURS, désactivé tant qu'il n'y est pas cité).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Vectorisation de secours (Groq n'en a pas : avec LLM_SECOURS=groq, pas de secours pour les embeddings).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Groq (LLM_SECOURS=groq) : API compatible OpenAI, même client avec une autre URL. Pas de voix Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low
# Jetons par minute autorisés (offre gratuite : 8000). Au-delà : erreur « Cours trop long pour le fournisseur de secours ».
GROQ_TOKENS_PAR_MINUTE=8000
# Jetons de réflexion réservés en plus de la sortie demandée (comptés dans la limite par minute).
# GROQ_MARGE_REFLEXION=400

# --- Stockage ---
# Fichiers des cours (PDF, audio) dans cours-service. Docker : /home/bawsla/cours (volume).
# COURS_STOCKAGE_DOSSIER=./uploads/cours
# Modèles ML du module User (ai-service). Par défaut app/modules/user/ml/modeles/, ou un dossier temporaire si non modifiable.
# USER_ML_DOSSIER=

# --- Voix (module Cours) : chaîne de secours, essayée dans cet ordre ---
# elevenlabs (clé requise), gemini (LLM_PROVIDER=gemini), openai (OPENAI_API_KEY), gtts (sans clé), edge (sans clé, parfois bloqué par Microsoft).
# Un fournisseur sans clé est ignoré ; en cas d échec (quota, 401, 403, 429) on passe au suivant.
TTS_FOURNISSEURS=elevenlabs,gemini,gtts,edge
ELEVENLABS_API_KEY=
# Identifiants de voix ElevenLabs (une pour le professeur, une pour l étudiant des dialogues).
ELEVENLABS_VOICE_PROF=
ELEVENLABS_VOICE_ETUDIANT=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Forum (forum-service) ---
# Indexe un texte de cours de démonstration pour La Vigie tant que le texte réel des cours manque.
FORUM_RAG_TEXTE_DEMO=false
